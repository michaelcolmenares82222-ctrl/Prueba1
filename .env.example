# =====================================================================
# Universal AI Assistant — Environment Variables
# =====================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and stays on your machine.
# =====================================================================

# ---------------------------------------------------------------------
# Recommended: OpenRouter API key (preferred chat provider)
# ---------------------------------------------------------------------
# 1. Crea una cuenta gratis en https://openrouter.ai/
# 2. Genera una key en https://openrouter.ai/keys
# 3. Pega la key debajo (empieza con "sk-or-...").
# Used for: chat + tool routing del CopilotKit runtime, vía OpenAIAdapter.
# Si está presente, se usa por encima de Groq.
#
# Free-tier: 20 req/min, 200 req/día por IP en modelos `:free`.
# (Si recargas $10+ a la cuenta sube a 1000 RPD por modelo).
OPENROUTER_API_KEY=placeholder_add_your_openrouter_key_here

# Modelo de OpenRouter (opcional). Default: z-ai/glm-4.5-air:free
# Catálogo completo: https://openrouter.ai/models
# Otros free verificados con tool-calling estable:
#   openai/gpt-oss-120b:free   (provider OpenInference, conciso)
#   openai/gpt-oss-20b:free    (más pequeño, más rápido)
# Evita modelos servidos por Venice (rate-limit upstream constante):
#   meta-llama/llama-3.3-70b-instruct:free, qwen/qwen3-*:free
# OPENROUTER_CHAT_MODEL=z-ai/glm-4.5-air:free

# ---------------------------------------------------------------------
# Optional fallback: Groq API key
# ---------------------------------------------------------------------
# Si OPENROUTER_API_KEY no está configurada, se usa Groq como fallback.
# 1. Create an account at https://console.groq.com/
# 2. Generate a key at https://console.groq.com/keys
# 3. Paste the key below (starts with "gsk_...")
# Used for: Llama 3.x via @copilotkit/runtime + groq-sdk.
GROQ_API_KEY=placeholder_add_your_key_here

# ---------------------------------------------------------------------
# Optional: Groq model overrides
# ---------------------------------------------------------------------
# Free-tier Groq enforces a per-model token-per-day quota. If you exhaust it,
# all requests for that model are blocked until the daily reset (UTC midnight).
# These two variables let you swap models without code changes.
#
# GROQ_CHAT_MODEL       → used by /api/copilotkit (chat + tool routing).
# GROQ_GENERATION_MODEL → used by /api/generate-ui (rich JSON content).
#
# Chat (/api/copilotkit): default is llama-3.1-8b-instant (broad access, ~500k TPD).
# If your account supports it and you have quota:
#   GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Kimi / other IDs only if listed for your org at https://console.groq.com/docs/models
#
# Leave commented to use the in-code defaults.
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_GENERATION_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# Optional: Public app URL
# ---------------------------------------------------------------------
# Used by client-side code (e.g. CopilotKit runtime endpoint, share links).
# In production, set this to your deployed URL (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000